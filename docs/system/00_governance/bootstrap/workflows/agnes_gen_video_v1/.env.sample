# Agnes Video Generation v1 - Environment Configuration
# Copy this file to .env in your project root and fill in your values.

# Agnes API Key(s) for round-robin rotation
# Use numbered keys for automatic rotation: AGNES_API_KEY_1, AGNES_API_KEY_2, ...
# Or use a single bare key: AGNES_API_KEY
# Examples:
AGNES_API_KEY_1=your_api_key_here
# AGNES_API_KEY_2=your_second_api_key_here
# AGNES_API_KEY_3=your_third_api_key_here

# Agnes API Base URL (optional, defaults to https://apihub.agnes-ai.com)
# AGNES_BASE_URL=https://apihub.agnes-ai.com
