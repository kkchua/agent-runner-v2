{
  "image": {
    "model": "agnes-image-2.1-flash",
    "size": "1024x1024",
    "ratio": "1:1"
  },
  "video": {
    "model": "agnes-video-v2.0",
    "width": 1024,
    "height": 1024,
    "num_frames": 48,
    "frame_rate": 24
  },
  "pipeline": {
    "num_variants": 4,
    "process_delay": 2,
    "coder_timeout": 600,
    "api_timeout": 120,
    "api_max_retries": 5
  }
}
