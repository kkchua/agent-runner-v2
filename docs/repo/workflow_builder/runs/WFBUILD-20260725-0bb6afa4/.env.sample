# Agnes Media Generation v1 - Environment Variables
# Copy this file to .env in the target repository root and fill in values.

# API key for Agnes API hub authentication.
# Used by generate_images and generate_videos actions to authenticate
# requests to the Agnes Image 2.1 Flash and Agnes Video V2.0 APIs.
AGNES_API_KEY=your_api_key_here

# Base URL for the Agnes API hub.
# The image generation endpoint is: {AGNES_BASE_URL}/v1/images/generations
# The video generation endpoint is: {AGNES_BASE_URL}/v1/videos
AGNES_BASE_URL=https://apihub.agnes-ai.com
