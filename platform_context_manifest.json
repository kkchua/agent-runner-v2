{
  "schema_version": "1.0",
  "platform_id": "agent-runner-v2",
  "generated_on": "2026-07-20",
  "purpose": "Curated platform knowledge map for specialized agents working in the agent-runner-v2 repository.",
  "usage_contract": {
    "primary_rule": "Use this manifest as the first lookup source before scanning the repository.",
    "secondary_rule": "Prefer published governance and platform constitution docs before reading implementation code.",
    "fallback_rule": "If the manifest does not answer the question, run a targeted search only within the most relevant path group.",
    "do_not_default_to_repo_wide_scan": true
  },
  "authoritative_sources": {
    "masterplan": {
      "path": "masterplan/",
      "role": "Human-authored design authority for layer boundaries and workflow specifications."
    },
    "layer1_governance_current": {
      "path": "docs/system/00_governance/foundation/current/",
      "role": "Active Layer 1 governance set."
    },
    "layer1_governance_history": {
      "path": "docs/system/00_governance/foundation/history/",
      "role": "Published historical Layer 1 governance snapshots."
    },
    "layer1_governance_runs": {
      "path": "docs/system/00_governance/foundation/runs/",
      "role": "Run-scoped Layer 1 review, validation, audit, and staging artifacts."
    },
    "layer2_platform_current": {
      "path": "docs/system/00_governance/platform/current/",
      "role": "Active Layer 2 platform constitution for agent-runner-v2."
    },
    "layer2_platform_history": {
      "path": "docs/system/00_governance/platform/history/",
      "role": "Published historical Layer 2 platform constitution snapshots."
    },
    "layer2_platform_runs": {
      "path": "docs/system/00_governance/platform/runs/",
      "role": "Run-scoped Layer 2 review, validation, audit, and staging artifacts."
    },
    "bootstrap_governance": {
      "path": "docs/system/00_governance/bootstrap/",
      "role": "Bootstrap and bundle-governance patterns, generated agent guidance, and workflow governance scaffolding."
    },
    "workflow_bundles": {
      "path": "workflows/",
      "role": "Concrete Layer 3 workflow bundle definitions."
    },
    "platform_code": {
      "path": "agent_runner_v2/",
      "role": "Implementation code for runtime, routing, coder integration, daemon mode, and shared services."
    }
  },
  "published_manifests": {
    "layer1_active_manifest": "docs/system/00_governance/foundation/current/governance_set_manifest.json",
    "layer1_history_manifest_pattern": "docs/system/00_governance/foundation/history/<job_id>/governance_set_manifest.json",
    "layer2_active_manifest": "docs/system/00_governance/platform/current/platform_set_manifest.json",
    "layer2_history_manifest_pattern": "docs/system/00_governance/platform/history/<job_id>/platform_set_manifest.json"
  },
  "workflow_bundles_known": [
    "00_bootstrap_lifecycle_admin_v1",
    "00_repo_master_docs_bootstrap_v1",
    "01_governance_foundation_v1",
    "02_agent_runner_platform_v1"
  ],
  "runtime_state": {
    "job_state_root": "~/.ukbe-runner/jobs/<workflow_name>/<job_id>/",
    "global_registry_root": "~/.ukbe-runner/workflows/default/_registry/",
    "notes": [
      "Job state is runtime data outside the repository working tree.",
      "Use repository docs first to understand the state model before inspecting runtime state directories."
    ]
  },
  "topic_routes": [
    {
      "topic": "layer1_governance",
      "start_with": [
        "docs/system/00_governance/foundation/current/",
        "masterplan/LAYER1_GOVERNANCE_SPECIFICATION.md",
        "masterplan/LAYER_ARCHITECTURE_MASTERPLAN.md"
      ],
      "then_check": [
        "docs/system/00_governance/foundation/current/governance_set_manifest.json",
        "docs/system/00_governance/foundation/history/",
        "docs/system/00_governance/foundation/runs/"
      ],
      "avoid_defaulting_to": [
        "agent_runner_v2/",
        "workflows/"
      ]
    },
    {
      "topic": "platform_constitution",
      "start_with": [
        "docs/system/00_governance/platform/current/README.md",
        "docs/system/00_governance/platform/current/RUNTIME_MODEL.md",
        "docs/system/00_governance/platform/current/BUNDLE_AUTHORING_CONTRACT.md",
        "docs/system/00_governance/platform/current/SHARED_SERVICES.md",
        "docs/system/00_governance/platform/current/METADATA_CONTRACT.md",
        "docs/system/00_governance/platform/current/VALIDATION_CONTRACT.md"
      ],
      "then_check": [
        "docs/system/00_governance/platform/current/platform_set_manifest.json",
        "docs/system/00_governance/platform/history/",
        "docs/system/00_governance/platform/runs/"
      ],
      "avoid_defaulting_to": [
        "masterplan/",
        "agent_runner_v2/"
      ]
    },
    {
      "topic": "workflow_bundle_docs_and_contracts",
      "start_with": [
        "workflows/<workflow_name>/workflow.toml",
        "workflows/<workflow_name>/bundle_governance.toml",
        "workflows/<workflow_name>/bundle_governance/",
        "docs/system/00_governance/platform/current/BUNDLE_AUTHORING_CONTRACT.md"
      ],
      "then_check": [
        "workflows/_registry/",
        "docs/system/00_governance/bootstrap/workflows/"
      ],
      "avoid_defaulting_to": [
        "repo-wide scans"
      ]
    },
    {
      "topic": "job_history_and_evidence",
      "start_with": [
        "docs/system/00_governance/foundation/runs/",
        "docs/system/00_governance/platform/runs/",
        "docs/system/00_governance/foundation/history/",
        "docs/system/00_governance/platform/history/"
      ],
      "then_check": [
        "~/.ukbe-runner/jobs/<workflow_name>/<job_id>/"
      ],
      "notes": [
        "Use docs/system runs/history when the question is about governance or platform generation evidence.",
        "Use ~/.ukbe-runner/jobs when the question is about live runtime job state or step execution state."
      ]
    },
    {
      "topic": "runtime_execution_model",
      "start_with": [
        "docs/system/00_governance/platform/current/RUNTIME_MODEL.md"
      ],
      "then_check": [
        "agent_runner_v2/run_agent.py",
        "agent_runner_v2/step_runner.py",
        "agent_runner_v2/workflow_router.py",
        "agent_runner_v2/job_state.py",
        "agent_runner_v2/workflow_runtime.py",
        "agent_runner_v2/step_execution_runtime.py"
      ],
      "avoid_defaulting_to": [
        "unrelated action modules"
      ]
    },
    {
      "topic": "daemon_and_worker_runtime",
      "start_with": [
        "docs/system/00_governance/platform/current/RUNTIME_MODEL.md",
        "docs/system/00_governance/platform/current/SHARED_SERVICES.md"
      ],
      "then_check": [
        "agent_runner_v2/daemon.py",
        "agent_runner_v2/daemon_runtime.py",
        "agent_runner_v2/backend_client.py",
        "agent_runner_v2/backend_execution.py",
        "agent_runner_v2/submitter.py"
      ],
      "notes": [
        "Daemon mode uses the same run_agent execution path as CLI mode.",
        "Backend coordination and polling behavior belong here."
      ]
    },
    {
      "topic": "coder_integration",
      "start_with": [
        "docs/system/00_governance/platform/current/RUNTIME_MODEL.md"
      ],
      "then_check": [
        "agent_runner_v2/coder_adapters.py",
        "agent_runner_v2/coder_registry.py",
        "workflows/<workflow_name>/_registry/",
        "~/.ukbe-runner/workflows/default/_registry/"
      ],
      "notes": [
        "The meta.json sidecar is the sole communication channel between coder and runner."
      ]
    },
    {
      "topic": "metadata_and_validation",
      "start_with": [
        "docs/system/00_governance/platform/current/METADATA_CONTRACT.md",
        "docs/system/00_governance/platform/current/VALIDATION_CONTRACT.md",
        "docs/system/00_governance/foundation/current/METADATA_STANDARD.md"
      ],
      "then_check": [
        "agent_runner_v2/actions/documentation_validation_core.py",
        "agent_runner_v2/documentation_guardrails.py",
        "agent_runner_v2/workflow_bundle_validator.py"
      ]
    },
    {
      "topic": "artifact_paths_and_shared_services",
      "start_with": [
        "docs/system/00_governance/platform/current/SHARED_SERVICES.md"
      ],
      "then_check": [
        "agent_runner_v2/artifact_paths.py",
        "agent_runner_v2/artifact_keys.py",
        "agent_runner_v2/doc_paths.py",
        "agent_runner_v2/path_catalog.py",
        "agent_runner_v2/workflow_path_contracts.py"
      ]
    }
  ],
  "entry_points": {
    "cli": "agent_runner_v2/run_agent.py",
    "daemon": "agent_runner_v2/daemon.py",
    "manual_approval": "agent_runner_v2/manual_runtime.py",
    "operator_console": "agent_runner_v2/console_commands.py"
  },
  "implementation_modules": {
    "runtime_core": [
      "agent_runner_v2/run_agent.py",
      "agent_runner_v2/step_runner.py",
      "agent_runner_v2/step_execution_runtime.py",
      "agent_runner_v2/workflow_runtime.py",
      "agent_runner_v2/workflow_router.py",
      "agent_runner_v2/job_state.py"
    ],
    "daemon_backend": [
      "agent_runner_v2/daemon.py",
      "agent_runner_v2/daemon_runtime.py",
      "agent_runner_v2/backend_client.py",
      "agent_runner_v2/backend_execution.py",
      "agent_runner_v2/submitter.py"
    ],
    "coder_stack": [
      "agent_runner_v2/coder_adapters.py",
      "agent_runner_v2/coder_registry.py"
    ],
    "shared_services_and_paths": [
      "agent_runner_v2/artifact_keys.py",
      "agent_runner_v2/artifact_paths.py",
      "agent_runner_v2/doc_paths.py",
      "agent_runner_v2/path_catalog.py",
      "agent_runner_v2/workflow_path_contracts.py",
      "agent_runner_v2/runtime_context.py"
    ],
    "validation_and_guardrails": [
      "agent_runner_v2/actions/documentation_validation_core.py",
      "agent_runner_v2/documentation_guardrails.py",
      "agent_runner_v2/workflow_bundle_validator.py"
    ]
  },
  "agent_behavior_defaults": {
    "prefer_current_sets_over_history": true,
    "prefer_docs_before_code": true,
    "treat_masterplan_and_published_governance_as_read_only_authority": true,
    "use_targeted_search_scopes_only": true,
    "surface_exact_paths_when_answering": true
  }
}
