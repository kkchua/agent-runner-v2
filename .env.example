# VideoExpress Workflow Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# ComfyUI Server Configuration (Required for T2I and I2V)
# =============================================================================
COMFYUI_BASE_URL=https://your-comfyui-server.com
COMFYUI_EMAIL=your-email@example.com
COMFYUI_PASSWORD=your-password
COMFYUI_DELAY_SECONDS=5

# =============================================================================
# TTS (Voiceover) Configuration
# =============================================================================

# TTS Provider: elevenlabs | openai | local
TTS_PROVIDER=elevenlabs

# Voice ID/Name (provider-specific)
# For ElevenLabs: use your Voice ID (e.g., "21m00Tcm4TlvDq8ikWAM")
# For OpenAI: use voice name (e.g., "alloy", "echo", "fable", "onyx", "nova", "shimmer")
TTS_VOICE_ID=default

# Delay between voiceover generations (seconds)
TTS_DELAY_SECONDS=1

# API Keys (required for cloud TTS providers)
ELEVENLABS_API_KEY=your-elevenlabs-api-key
OPENAI_API_KEY=your-openai-api-key

# =============================================================================
# Video Assembly Configuration
# =============================================================================

# Aspect Ratio: 9:16 (TikTok/Shorts) | 16:9 (YouTube) | 1:1 (Square)
VIDEO_ASPECT_RATIO=9:16

# Frame Rate
VIDEO_FPS=30

# Output Format: mp4 | mov | webm
VIDEO_FORMAT=mp4

# =============================================================================
# Workflow Overrides (Optional)
# These can override template_groups.py configuration at runtime
# =============================================================================

# T2I Workflow Key Override
# WORKFLOW_KEY_T2I_OVERRIDE=YourCustom/T2I-Workflow

# I2V Workflow Key Override  
# WORKFLOW_KEY_I2V_OVERRIDE=YourCustom/I2V-Workflow

# TTS Provider Override
# TTS_PROVIDER_OVERRIDE=openai

# TTS Voice Override
# TTS_VOICE_OVERRIDE=nova

# Aspect Ratio Override
# ASPECT_RATIO_OVERRIDE=16:9

# =============================================================================
# Notification Configuration (Optional)
# Send notifications on workflow completion/failure
# Both Pushover and Telegram can be enabled independently
# =============================================================================

# Pushover Application Token (create at https://pushover.net/apps)
PUSHOVER_API_TOKEN=your-pushover-app-token

# Pushover User Key (find at https://pushover.net/)
PUSHOVER_USER_KEY=your-pushover-user-key

# Telegram Bot Token (create via @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Telegram Chat ID (group, channel, or user chat ID)
TELEGRAM_CHAT_ID=your-telegram-chat-id
