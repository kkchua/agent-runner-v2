# Agnes Media Generation v1 - Environment Variables
# Copy this file to .env in the target repository root and fill in values.

# API keys for Agnes services (image and video generation).
# Multiple keys are supported via round-robin rotation — each API call uses
# the next key in sequence, looping back to the first after the last.
# Obtain from your Agnes account dashboard.
AGNES_API_KEY_1=your_first_api_key_here
AGNES_API_KEY_2=your_second_api_key_here
# AGNES_API_KEY_3=add_more_keys_as_needed

# Single key fallback: if no numbered keys (AGNES_API_KEY_N) are found,
# the bare AGNES_API_KEY is used (backward compatible).
# AGNES_API_KEY=your_single_api_key_here

# Base URL for the Agnes API endpoints.
# Default production URL shown below. Change for staging or mock environments.
AGNES_BASE_URL=https://apihub.agnes-ai.com
