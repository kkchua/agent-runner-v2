{
  "image": {
    "model": "agnes-image-2.1-flash",
    "size": "1024x1024",
    "ratio": "1:1"
  },
  "video": {
    "model": "agnes-video-v2.0",
    "width": 1024,
    "height": 576,
    "num_frames": 72,
    "frame_rate": 24,
    "video_prompt": "t2v_prompt1",
    "video_prompt_prefix": "",
    "video_prompt_postfix": "",
    "negative_prompt_video_postfix": ""
  },
  "num_variants": 4,
  "max_concurrent": 2,
  "process_delay": 15,
  "coder_timeout": 900,
  "api_timeout": 500,
  "api_max_retries": 5,
  "retry_base_wait": 5
}
