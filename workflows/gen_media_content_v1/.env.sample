# Agnes API (image + video)
# Obtain from your Agnes account dashboard.
AGNES_API_KEY_1=<replace_with_your_key>
AGNES_BASE_URL=https://apihub.agnes-ai.com

# HappyHorse API (DashScope-based video generation)
# Uses Alibaba Cloud DashScope API format.
HAPPYHORSE_API_KEY_1=<replace_with_your_key>
HAPPYHORSE_BASE_URL=https://dashscope.aliyuncs.com
